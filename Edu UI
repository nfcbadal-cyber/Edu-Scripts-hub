--[[
    ModernUI Library v2.0
    Made for Executors + CoreGui
    Supports: Tabs, Sections, Toggle, Slider, Dropdown, Textbox, Button,
              Keybind, Paragraph, Label, ColorPicker, Divider, Spacer,
              Notify, Floating Hexagon Button, Draggable Window
]]

local TweenService      = game:GetService("TweenService")
local UserInputService  = game:GetService("UserInputService")
local RunService        = game:GetService("RunService")

-- ============================================================
-- PARENT (safe CoreGui fallback)
-- ============================================================
local function GetParent()
    if gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then return cg end
    return game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

local ParentGui = GetParent()

-- ============================================================
-- LIBRARY
-- ============================================================
local Library = {}
Library.__index = Library
Library.Flags = {}
Library.Options = {}

-- ============================================================
-- HELPERS
-- ============================================================
local function Create(name, props, children)
    local obj = Instance.new(name)
    for i, v in pairs(props or {}) do
        obj[i] = v
    end
    for _, child in pairs(children or {}) do
        child.Parent = obj
    end
    return obj
end

local function Tween(obj, props, duration, style, dir)
    TweenService:Create(
        obj,
        TweenInfo.new(
            duration or 0.2,
            style or Enum.EasingStyle.Quad,
            dir or Enum.EasingDirection.Out
        ),
        props
    ):Play()
end

local function SafeCallback(fn, ...)
    if not fn then return end
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[ModernUI] Callback error: " .. tostring(err))
    end
end

-- ============================================================
-- CREATE WINDOW
-- ============================================================
function Library:CreateWindow(config)
    config = config or {}
    local windowName  = config.Name or "Modern UI"
    local toggleKey   = config.Keybind or Enum.KeyCode.RightControl
    local accentColor = config.Accent or Color3.fromRGB(90, 70, 220)
    local showFloat   = config.FloatingButton ~= false

    -- ScreenGui
    local ScreenGui = Create("ScreenGui", {
        Name = "ModernUI_Lib",
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        ResetOnSpawn = false,
        Parent = ParentGui
    })

    -- Main Frame
    local Main = Create("Frame", {
        Name = "Main",
        Size = UDim2.new(0, 520, 0, 430),
        Position = UDim2.new(0.5, -260, 0.5, -215),
        BackgroundColor3 = Color3.fromRGB(18, 18, 24),
        BorderSizePixel = 0,
        Active = true,
        Parent = ScreenGui
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0, 14)}),
        Create("UIStroke", {Color = Color3.fromRGB(55, 55, 75), Thickness = 1.2})
    })

    -- ============================================================
    -- MANUAL DRAG (fixes Draggable bug)
    -- ============================================================
    do
        local dragging, dragStart, startPos
        local dragBar = Main

        dragBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging  = true
                dragStart = input.Position
                startPos  = Main.Position
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and (
                input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch
            ) then
                local delta = input.Position - dragStart
                Main.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    -- Title Bar
    local TitleBar = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = Color3.fromRGB(25, 25, 33),
        BorderSizePixel = 0,
        Parent = Main
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0, 14)}),
        Create("Frame", {
            Size = UDim2.new(1, 0, 0, 16),
            Position = UDim2.new(0, 0, 1, -16),
            BackgroundColor3 = Color3.fromRGB(25, 25, 33),
            BorderSizePixel = 0
        })
    })

    Create("TextLabel", {
        Size = UDim2.new(1, -90, 1, 0),
        Position = UDim2.new(0, 16, 0, 0),
        BackgroundTransparency = 1,
        Text = windowName,
        TextColor3 = Color3.fromRGB(235, 235, 250),
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = TitleBar
    })

    -- Minimize Button
    local MinBtn = Create("TextButton", {
        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -72, 0.5, -15),
        BackgroundColor3 = Color3.fromRGB(40, 40, 52),
        Text = "–",
        TextColor3 = Color3.fromRGB(230, 230, 240),
        Font = Enum.Font.GothamBold,
        TextSize = 18,
        Parent = TitleBar
    }, {Create("UICorner", {CornerRadius = UDim.new(0, 8)})})

    -- Close Button
    local CloseBtn = Create("TextButton", {
        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -38, 0.5, -15),
        BackgroundColor3 = Color3.fromRGB(40, 40, 52),
        Text = "×",
        TextColor3 = Color3.fromRGB(230, 230, 240),
        Font = Enum.Font.GothamBold,
        TextSize = 18,
        Parent = TitleBar
    }, {Create("UICorner", {CornerRadius = UDim.new(0, 8)})})

    -- Tab Container
    local TabContainer = Create("Frame", {
        Size = UDim2.new(1, -24, 0, 36),
        Position = UDim2.new(0, 12, 0, 52),
        BackgroundTransparency = 1,
        Parent = Main
    }, {
        Create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            Padding = UDim.new(0, 8)
        })
    })

    -- Content
    local Content = Create("ScrollingFrame", {
        Size = UDim2.new(1, -24, 1, -100),
        Position = UDim2.new(0, 12, 0, 96),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Color3.fromRGB(80, 80, 110),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = Main
    }, {
        Create("UIListLayout", {Padding = UDim.new(0, 12)})
    })

    -- ============================================================
    -- FLOATING HEXAGON BUTTON
    -- ============================================================
    local FloatingButton
    if showFloat then
        FloatingButton = Create("ImageButton", {
            Name = "HexButton",
            Size = UDim2.new(0, 48, 0, 48),
            Position = UDim2.new(0, 24, 0.5, -24),
            BackgroundTransparency = 1,
            Image = "rbxassetid://108314863613046", -- hexagon shape
            ImageColor3 = accentColor,
            Visible = false,
            ZIndex = 9999,
            Parent = ScreenGui
        }, {
            Create("UICorner", {CornerRadius = UDim.new(1, 0)}),
            Create("ImageLabel", {
                Name = "Icon",
                Size = UDim2.new(0.55, 0, 0.55, 0),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundTransparency = 1,
                Image = "rbxassetid://10734951730", -- spark / moon icon
                ImageColor3 = Color3.fromRGB(255, 255, 255),
            })
        })

        -- Drag floating button
        do
            local dragging, dragStart, startPos
            FloatingButton.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging  = true
                    dragStart = input.Position
                    startPos  = FloatingButton.Position
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    local delta = input.Position - dragStart
                    FloatingButton.Position = UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + delta.X,
                        startPos.Y.Scale, startPos.Y.Offset + delta.Y
                    )
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
        end

        FloatingButton.MouseButton1Click:Connect(function()
            Main.Visible = true
            FloatingButton.Visible = false
            Tween(Main, {Size = UDim2.new(0, 520, 0, 430)}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end)
    end

    -- Minimize / Restore
    local minimized = false
    local originalSize = Main.Size

    MinBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            MinBtn.Text = "□"
            Tween(Main, {Size = UDim2.new(0, 520, 0, 44)}, 0.25)
            Content.Visible = false
            TabContainer.Visible = false
        else
            MinBtn.Text = "–"
            Tween(Main, {Size = originalSize}, 0.25)
            Content.Visible = true
            TabContainer.Visible = true
        end
    end)

    -- Close → shows hexagon (instead of destroying)
    CloseBtn.MouseButton1Click:Connect(function()
        Main.Visible = false
        if FloatingButton then
            FloatingButton.Visible = true
        end
    end)

    -- Keybind toggle
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == toggleKey then
            Main.Visible = not Main.Visible
            if FloatingButton then
                FloatingButton.Visible = not Main.Visible
            end
        end
    end)

    -- ============================================================
    -- WINDOW OBJECT
    -- ============================================================
    local Window = {}
    Window.Tabs       = {}
    Window.Accent     = accentColor
    Window.ScreenGui  = ScreenGui
    Window.Main       = Main
    Window.Floating   = FloatingButton

    function Window:SetTitle(newTitle)
        TitleBar:FindFirstChildOfClass("TextLabel").Text = newTitle
    end

    function Window:SetAccent(color)
        Window.Accent = color
        if FloatingButton then
            FloatingButton.ImageColor3 = color
        end
    end

    function Window:Destroy()
        ScreenGui:Destroy()
    end

    -- ============================================================
    -- NOTIFY SYSTEM
    -- ============================================================
    local NotifyHolder = Create("Frame", {
        Size = UDim2.new(0, 280, 1, -40),
        Position = UDim2.new(1, -300, 0, 20),
        BackgroundTransparency = 1,
        ZIndex = 10000,
        Parent = ScreenGui
    }, {
        Create("UIListLayout", {
            Padding = UDim.new(0, 8),
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            SortOrder = Enum.SortOrder.LayoutOrder
        })
    })

    function Window:Notify(cfg)
        cfg = cfg or {}
        local title    = cfg.Title or "Notification"
        local content  = cfg.Content or ""
        local duration = cfg.Duration or 4

        local Card = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = Color3.fromRGB(28, 28, 38),
            BorderSizePixel = 0,
            ZIndex = 10001,
            Parent = NotifyHolder
        }, {
            Create("UICorner", {CornerRadius = UDim.new(0, 10)}),
            Create("UIStroke", {Color = accentColor, Thickness = 1}),
            Create("UIPadding", {
                PaddingTop = UDim.new(0, 10),
                PaddingBottom = UDim.new(0, 10),
                PaddingLeft = UDim.new(0, 12),
                PaddingRight = UDim.new(0, 12)
            }),
            Create("UIListLayout", {Padding = UDim.new(0, 4)})
        })

        Create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Text = title,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            Font = Enum.Font.GothamBold,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            Parent = Card
        })

        Create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Text = content,
            TextColor3 = Color3.fromRGB(190, 190, 210),
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            Parent = Card
        })

        task.delay(duration, function()
            Tween(Card, {BackgroundTransparency = 1}, 0.3)
            for _, child in pairs(Card:GetDescendants()) do
                if child:IsA("TextLabel") then
                    Tween(child, {TextTransparency = 1}, 0.3)
                end
            end
            task.wait(0.35)
            Card:Destroy()
        end)
    end

    -- ============================================================
    -- CREATE TAB
    -- ============================================================
    function Window:CreateTab(name)
        local TabBtn = Create("TextButton", {
            Size = UDim2.new(0, 110, 1, 0),
            BackgroundColor3 = Color3.fromRGB(35, 35, 48),
            Text = name,
            TextColor3 = Color3.fromRGB(200, 200, 220),
            Font = Enum.Font.GothamMedium,
            TextSize = 13,
            Parent = TabContainer
        }, {Create("UICorner", {CornerRadius = UDim.new(0, 8)})})

        local TabContent = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Visible = false,
            Parent = Content
        }, {
            Create("UIListLayout", {Padding = UDim.new(0, 12)})
        })

        if #Window.Tabs == 0 then
            TabContent.Visible = true
            TabBtn.BackgroundColor3 = accentColor
            TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end

        TabBtn.MouseButton1Click:Connect(function()
            for _, t in pairs(Window.Tabs) do
                t.Content.Visible = false
                t.Button.BackgroundColor3 = Color3.fromRGB(35, 35, 48)
                t.Button.TextColor3 = Color3.fromRGB(200, 200, 220)
            end
            TabContent.Visible = true
            TabBtn.BackgroundColor3 = accentColor
            TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end)

        local Tab = {Button = TabBtn, Content = TabContent}
        table.insert(Window.Tabs, Tab)

        -- ============================================================
        -- SECTION
        -- ============================================================
        function Tab:CreateSection(title)
            local Section = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Color3.fromRGB(28, 28, 38),
                BorderSizePixel = 0,
                Parent = TabContent
            }, {
                Create("UICorner", {CornerRadius = UDim.new(0, 10)}),
                Create("UIPadding", {PaddingBottom = UDim.new(0, 12)})
            })

            Create("TextLabel", {
                Size = UDim2.new(1, -20, 0, 28),
                Position = UDim2.new(0, 12, 0, 6),
                BackgroundTransparency = 1,
                Text = title,
                TextColor3 = Color3.fromRGB(160, 160, 190),
                Font = Enum.Font.GothamBold,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = Section
            })

            local Holder = Create("Frame", {
                Size = UDim2.new(1, -20, 0, 0),
                Position = UDim2.new(0, 10, 0, 34),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Parent = Section
            }, {
                Create("UIListLayout", {Padding = UDim.new(0, 8)})
            })

            local SectionObj = {}

            -- ---------- Paragraph ----------
            function SectionObj:CreateParagraph(text)
                local L = Create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(180, 180, 200),
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Holder
                })
                return {
                    Set = function(_, newText) L.Text = newText end,
                    Instance = L
                }
            end

            -- ---------- Label ----------
            function SectionObj:CreateLabel(text)
                local L = Create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 22),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(160, 160, 190),
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Holder
                })
                return {
                    Set = function(_, newText) L.Text = newText end,
                    Instance = L
                }
            end

            -- ---------- Divider ----------
            function SectionObj:CreateDivider()
                Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = Color3.fromRGB(60, 60, 80),
                    BorderSizePixel = 0,
                    Parent = Holder
                })
            end

            -- ---------- Spacer ----------
            function SectionObj:CreateSpacer(height)
                Create("Frame", {
                    Size = UDim2.new(1, 0, 0, height or 12),
                    BackgroundTransparency = 1,
                    Parent = Holder
                })
            end

            -- ---------- Toggle ----------
            function SectionObj:CreateToggle(text, default, callback)
                if type(default) == "function" then
                    callback = default
                    default = false
                end

                local Frame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundTransparency = 1,
                    Parent = Holder
                })

                Create("TextLabel", {
                    Size = UDim2.new(1, -60, 1, 0),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(220, 220, 235),
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Frame
                })

                local Toggle = Create("TextButton", {
                    Size = UDim2.new(0, 46, 0, 24),
                    Position = UDim2.new(1, -46, 0.5, -12),
                    BackgroundColor3 = Color3.fromRGB(45, 45, 60),
                    Text = "",
                    Parent = Frame
                }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})

                local Circle = Create("Frame", {
                    Size = UDim2.new(0, 18, 0, 18),
                    Position = UDim2.new(0, 3, 0.5, -9),
                    BackgroundColor3 = Color3.fromRGB(200, 200, 220),
                    Parent = Toggle
                }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})

                local enabled = default and true or false

                local function applyState(state, fire)
                    enabled = state
                    if enabled then
                        Tween(Toggle, {BackgroundColor3 = accentColor})
                        Tween(Circle, {Position = UDim2.new(1, -21, 0.5, -9)})
                    else
                        Tween(Toggle, {BackgroundColor3 = Color3.fromRGB(45, 45, 60)})
                        Tween(Circle, {Position = UDim2.new(0, 3, 0.5, -9)})
                    end
                    if fire and callback then SafeCallback(callback, enabled) end
                end

                applyState(enabled, false)

                Toggle.MouseButton1Click:Connect(function()
                    applyState(not enabled, true)
                end)

                return {
                    Set    = function(_, v) applyState(v, true) end,
                    Get    = function() return enabled end,
                    Toggle = Toggle
                }
            end

            -- ---------- Slider (touch fixed) ----------
            function SectionObj:CreateSlider(text, min, max, default, callback)
                local Frame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 48),
                    BackgroundTransparency = 1,
                    Parent = Holder
                })

                local Label = Create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    Text = text .. ": " .. tostring(default),
                    TextColor3 = Color3.fromRGB(220, 220, 235),
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Frame
                })

                local SliderBack = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 8),
                    Position = UDim2.new(0, 0, 0, 28),
                    BackgroundColor3 = Color3.fromRGB(40, 40, 55),
                    Parent = Frame
                }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})

                local Fill = Create("Frame", {
                    Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = accentColor,
                    Parent = SliderBack
                }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})

                local dragging = false

                local function UpdateFromInput(pos)
                    local percent = math.clamp(
                        (pos.X - SliderBack.AbsolutePosition.X) / SliderBack.AbsoluteSize.X,
                        0, 1
                    )
                    local value = math.floor(min + (max - min) * percent + 0.5)
                    Fill.Size = UDim2.new(percent, 0, 1, 0)
                    Label.Text = text .. ": " .. value
                    if callback then SafeCallback(callback, value) end
                end

                SliderBack.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        UpdateFromInput(input.Position)
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (
                        input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch
                    ) then
                        UpdateFromInput(input.Position)
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                return {
                    Set = function(_, v)
                        local percent = math.clamp((v - min) / (max - min), 0, 1)
                        Fill.Size = UDim2.new(percent, 0, 1, 0)
                        Label.Text = text .. ": " .. v
                        if callback then SafeCallback(callback, v) end
                    end,
                    Frame = Frame
                }
            end

            -- ---------- Dropdown ----------
            function SectionObj:CreateDropdown(text, options, default, callback)
                if type(default) == "function" then
                    callback = default
                    default = options[1]
                end

                local Frame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundTransparency = 1,
                    Parent = Holder
                })

                local Btn = Create("TextButton", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundColor3 = Color3.fromRGB(35, 35, 48),
                    Text = "  " .. text .. ": " .. tostring(default),
                    TextColor3 = Color3.fromRGB(220, 220, 235),
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Frame
                }, {Create("UICorner", {CornerRadius = UDim.new(0, 8)})})

                local Drop = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, #options * 30),
                    Position = UDim2.new(0, 0, 1, 4),
                    BackgroundColor3 = Color3.fromRGB(30, 30, 42),
                    Visible = false,
                    ZIndex = 10,
                    Parent = Frame
                }, {
                    Create("UICorner", {CornerRadius = UDim.new(0, 8)}),
                    Create("UIListLayout")
                })

                for _, opt in ipairs(options) do
                    local Opt = Create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 30),
                        BackgroundTransparency = 1,
                        Text = opt,
                        TextColor3 = Color3.fromRGB(210, 210, 230),
                        Font = Enum.Font.Gotham,
                        TextSize = 13,
                        ZIndex = 11,
                        Parent = Drop
                    })
                    Opt.MouseButton1Click:Connect(function()
                        Btn.Text = "  " .. text .. ": " .. opt
                        Drop.Visible = false
                        if callback then SafeCallback(callback, opt) end
                    end)
                end

                Btn.MouseButton1Click:Connect(function()
                    Drop.Visible = not Drop.Visible
                end)

                return {
                    Set = function(_, v)
                        Btn.Text = "  " .. text .. ": " .. tostring(v)
                        if callback then SafeCallback(callback, v) end
                    end,
                    Frame = Frame
                }
            end

            -- ---------- Textbox ----------
            function SectionObj:CreateTextbox(placeholder, callback)
                local Box = Create("TextBox", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundColor3 = Color3.fromRGB(35, 35, 48),
                    Text = "",
                    PlaceholderText = placeholder or "Type here...",
                    PlaceholderColor3 = Color3.fromRGB(120, 120, 145),
                    TextColor3 = Color3.fromRGB(230, 230, 245),
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    ClearTextOnFocus = false,
                    Parent = Holder
                }, {
                    Create("UICorner", {CornerRadius = UDim.new(0, 8)}),
                    Create("UIPadding", {PaddingLeft = UDim.new(0, 10)})
                })

                Box.FocusLost:Connect(function(enter)
                    if enter and callback then SafeCallback(callback, Box.Text) end
                end)

                return {
                    Set = function(_, v) Box.Text = v end,
                    Get = function() return Box.Text end,
                    Box = Box
                }
            end

            -- ---------- Button ----------
            function SectionObj:CreateButton(text, callback)
                local Btn = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 34),
                    BackgroundColor3 = accentColor,
                    Text = text,
                    TextColor3 = Color3.fromRGB(255, 255, 255),
                    Font = Enum.Font.GothamBold,
                    TextSize = 13,
                    Parent = Holder
                }, {Create("UICorner", {CornerRadius = UDim.new(0, 8)})})

                Btn.MouseButton1Click:Connect(function()
                    if callback then SafeCallback(callback) end
                end)

                return {
                    SetText = function(_, v) Btn.Text = v end,
                    Button  = Btn
                }
            end

            -- ---------- Keybind ----------
            function SectionObj:CreateKeybind(text, default, callback)
                local Frame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundTransparency = 1,
                    Parent = Holder
                })

                Create("TextLabel", {
                    Size = UDim2.new(1, -100, 1, 0),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(220, 220, 235),
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Frame
                })

                local currentKey = default or Enum.KeyCode.F
                local Btn = Create("TextButton", {
                    Size = UDim2.new(0, 90, 0, 24),
                    Position = UDim2.new(1, -90, 0.5, -12),
                    BackgroundColor3 = Color3.fromRGB(45, 45, 60),
                    Text = currentKey.Name,
                    TextColor3 = Color3.fromRGB(220, 220, 235),
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    Parent = Frame
                }, {Create("UICorner", {CornerRadius = UDim.new(0, 6)})})

                local picking = false

                Btn.MouseButton1Click:Connect(function()
                    picking = true
                    Btn.Text = "..."
                end)

                UserInputService.InputBegan:Connect(function(input, gpe)
                    if gpe then return end
                    if picking then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            currentKey = input.KeyCode
                            Btn.Text = currentKey.Name
                            picking = false
                            if callback then SafeCallback(callback, currentKey) end
                        end
                    else
                        if input.KeyCode == currentKey then
                            if callback then SafeCallback(callback, currentKey) end
                        end
                    end
                end)

                return {Btn = Btn}
            end

            -- ---------- Color Picker ----------
            function SectionObj:CreateColorPicker(text, default, callback)
                default = default or Color3.fromRGB(255, 255, 255)

                local Frame = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundTransparency = 1,
                    Parent = Holder
                })

                Create("TextLabel", {
                    Size = UDim2.new(1, -60, 1, 0),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Color3.fromRGB(220, 220, 235),
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Frame
                })

                local Swatch = Create("TextButton", {
                    Size = UDim2.new(0, 40, 0, 22),
                    Position = UDim2.new(1, -40, 0.5, -11),
                    BackgroundColor3 = default,
                    Text = "",
                    Parent = Frame
                }, {
                    Create("UICorner", {CornerRadius = UDim.new(0, 6)}),
                    Create("UIStroke", {Color = Color3.fromRGB(90, 90, 110), Thickness = 1})
                })

                Swatch.MouseButton1Click:Connect(function()
                    if callback then SafeCallback(callback, Swatch.BackgroundColor3) end
                end)

                return {
                    Set = function(_, c)
                        Swatch.BackgroundColor3 = c
                        if callback then SafeCallback(callback, c) end
                    end,
                    Swatch = Swatch
                }
            end

            return SectionObj
        end

        return Tab
    end

    return Window
end

return Library
